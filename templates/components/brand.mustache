{{!
    @template theme_edvorya/components/brand

    Reusable Edvorya product + institution lockup. The institution remains
    tenant-specific while the product identity stays consistent with Edvorya LMS.
}}
<a class="edv-brand" href="{{{ homeurl }}}" aria-label="Edvorya LMS - {{institutionname}}">
    {{#logourl}}
        <img class="edv-brand__logo" src="{{{ logourl }}}" alt="" decoding="async">
    {{/logourl}}
    {{^logourl}}
        <span class="edv-brand__mark" aria-hidden="true">E</span>
    {{/logourl}}
    <span class="edv-brand__copy">
        <span class="edv-brand__name">Edvorya LMS</span>
        <span class="edv-brand__meta">{{institutionname}}</span>
    </span>
</a>
