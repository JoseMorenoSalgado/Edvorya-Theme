{{!
    @template theme_edvorya/layout/embedded

    Minimal content layout used by embedded, popup, frame, print, and redirect page layouts.
}}
{{{ output.doctype }}}
<html {{{ output.htmlattributes }}}>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{{ output.page_title }}}</title>
    {{#branding}}
        {{> theme_edvorya/components/branding_head }}
    {{/branding}}
    {{{ output.standard_head_html }}}
</head>
<body {{{ bodyattributes }}}>
{{{ output.standard_top_of_body_html }}}

<div id="page-wrapper" class="edv-embedded-shell">
    <main id="page" data-region="mainpage" data-usertour="scroller" class="edv-embedded">
        <div id="topofscroll">
            <div id="page-content">
                <div id="region-main-box">
                    <section id="region-main">
                        {{{ output.course_content_header }}}
                        {{{ maincontent }}}
                        {{{ output.course_content_footer }}}
                    </section>
                </div>
            </div>
        </div>
    </main>
</div>

{{{ output.standard_after_main_region_html }}}
{{{ output.standard_end_of_body_html }}}
</body>
</html>
