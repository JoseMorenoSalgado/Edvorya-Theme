{
  "name": "moodle-theme-edvorya",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Build tooling for the standalone Edvorya Moodle theme",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/index.css -o ./style/edvorya.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/index.css -o ./style/edvorya.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
